{
  "name": "soromi",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "pnpm --filter @soromi/gui dev",
    "typecheck": "turbo run typecheck",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test": "vitest run --passWithNoTests",
    "dev:daemon": "cargo run -p soromi-daemon",
    "dev:desktop": "pnpm --filter @soromi/desktop dev",
    "dev:relay": "pnpm --filter @soromi/relay dev",
    "deploy:relay": "pnpm --filter @soromi/relay run deploy",
    "dev:mobile": "pnpm --dir apps/mobile start",
    "check:mobile": "pnpm --dir apps/mobile typecheck && pnpm --dir apps/mobile test && pnpm --dir apps/mobile bundle",
    "build:desktop:mac": "node scripts/build.mjs desktop mac",
    "build:desktop:linux": "node scripts/build.mjs desktop linux",
    "build:cli:mac": "node scripts/build.mjs cli mac",
    "build:cli:linux": "node scripts/build.mjs cli linux",
    "gen:protocol": "cargo test -p soromi-protocol --features ts",
    "changeset": "changeset",
    "release": "node scripts/release.mjs",
    "version-packages": "changeset version && cargo release version $(node -p \"require('./apps/desktop/package.json').version\") --workspace --execute --no-confirm",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@changesets/cli": "^2.27.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "electron",
      "electron-winstaller"
    ]
  }
}
