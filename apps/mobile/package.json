{
  "name": "@soromi/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit",
    "bundle": "expo export --platform ios --platform android --output-dir dist",
    "doctor": "expo-doctor",
    "test": "vitest run",
    "eas-build-post-install": "pnpm --dir ../.. install --frozen-lockfile --filter @soromi/core... --filter @soromi/protocol... && pnpm --dir ../.. --filter @soromi/protocol build",
    "gen:terminal": "node scripts/gen-terminal.mjs"
  },
  "dependencies": {
    "@soromi/core": "link:../../packages/core",
    "@soromi/protocol": "link:../../packages/protocol",
    "expo": "~57.0.28",
    "expo-build-properties": "~57.0.22",
    "expo-camera": "~57.0.6",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.20",
    "expo-crypto": "~57.0.4",
    "expo-device": "~57.0.2",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-image-picker": "~57.0.20",
    "expo-keep-awake": "~57.0.2",
    "expo-linking": "~57.0.12",
    "expo-network": "~57.0.2",
    "expo-notifications": "~57.0.22",
    "expo-router": "~57.0.26",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.21",
    "highlight.js": "^11.12.0",
    "lucide-react-native": "^1.52.0",
    "marked": "^18.1.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-webview": "13.16.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
